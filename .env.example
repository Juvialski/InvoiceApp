# Optional transitional development/demo key. Production company requests do
# not use it unless ALLOW_GLOBAL_GEMINI_FALLBACK is explicitly true.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required in production for encrypted per-company Gemini credentials.
# Generate 32 cryptographically random bytes and base64-encode them. This is
# server-only; never prefix it with VITE_ or expose it to the browser.
AI_CREDENTIALS_MASTER_KEY="BASE64_OF_32_RANDOM_BYTES"

# Dedicated backend-only Supabase secret/service-role-compatible key used only
# by the Express company AI envelope resolver. Never prefix with VITE_ or send
# this key to the browser.
SUPABASE_AI_SERVER_KEY="SUPABASE_SECRET_KEY_FOR_COMPANY_AI_ONLY"

# Keep false in production. A true value is only for a deliberate local/demo
# transition and may use GEMINI_API_KEY when a company key is not configured.
ALLOW_GLOBAL_GEMINI_FALLBACK="false"

# Optional runtime/deployment URL supplied by AI Studio / Cloud Run when available.
APP_URL="MY_APP_URL"
# Optional non-secret release identity surfaced by /api/health and the
# operator deployment verification tool. Leave unset when unknown.
HYDROQUALISENSE_DEPLOYMENT_ID=""
HYDROQUALISENSE_APP_VERSION=""
HYDROQUALISENSE_MIGRATION_LEVEL=""
HYDROQUALISENSE_CONFIGURATION_VERSION=""
# Server/operator identity. QA database commands require the exact `qa` value
# and an asserted QA project reference; production must keep its own value.
HYDROQUALISENSE_ENVIRONMENT="production"
HYDROQUALISENSE_QA_PROJECT_REF=""
HYDROQUALISENSE_PRODUCTION_PROJECT_REF=""
# Optional origin for the retired server invitation-delivery compatibility
# endpoint. Normal email access authorization uses the browser Auth flow.
APP_ORIGIN="https://your-engoryx-deployment.example"

# New Supabase project public client configuration.
# These are intentionally VITE_ variables because the browser Supabase client needs them.
# Use the project's URL and Publishable key (legacy anon key also works through VITE_SUPABASE_ANON_KEY).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
# VITE_SUPABASE_ANON_KEY="legacy-anon-key-if-needed"

# Public product/requirements funnel is deployment-opt-in. Keep false for
# operational client deployments such as the current Client A production site.
# A dedicated platform/QA deployment may enable it deliberately after the
# database-side public funnel gate is also enabled by an operator.
VITE_HYDROQUALISENSE_PUBLIC_FUNNEL_ENABLED="false"
VITE_HYDROQUALISENSE_ENVIRONMENT="production"
VITE_HYDROQUALISENSE_DEPLOYMENT_ID=""
VITE_HYDROQUALISENSE_CONFIGURATION_VERSION=""

# Optional presentation-only deployment configuration. Comma-separated module
# keys hide modules from navigation without changing RBAC/RLS or route authority.
# Safe default: omitted/empty means all existing modules remain visible.
# Keys: dashboard,cash,invoices,email-intake,projects,expenses,payroll,reports,engineering-documents,settings
VITE_ENGORYX_HIDDEN_MODULES=""

# QA-only sample presets. Keep disabled for production workspaces.
VITE_ENABLE_SAMPLE_INVOICES="false"
