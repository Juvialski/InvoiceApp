{
  "name": "engoryx",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run astryx:theme && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --experimental-strip-types tests/*.test.ts",
    "qa:demo": "tsx scripts/demo-visual-qa.ts",
    "workflow-map:generate": "tsx scripts/workflow-map/generate.ts",
    "workflow-map:check": "tsx scripts/workflow-map/validate.ts --check",
    "workflow-map:consistency": "tsx scripts/workflow-map/consistency.ts",
    "workflow-map:evidence": "tsx scripts/workflow-map/evidence-cli.ts",
    "workflow-map:context": "tsx scripts/workflow-map/context-cli.ts",
    "test:workflow-map": "node --test --experimental-strip-types tests/workflowMap.test.ts tests/workflowMapConsistency.test.ts tests/workflowMapEvidence.test.ts tests/workflowMapContext.test.ts",
    "test:visual": "tsx scripts/test-visual-canvas.ts",
    "test:migrations": "tsx scripts/test-migrations.ts",
    "test:migrations:upgrade": "tsx scripts/test-migration-upgrade.ts",
    "astryx": "astryx",
    "astryx:theme": "astryx theme build src/ui/engoryxTheme.ts --out src/ui/engoryx.css --icons-specifier ./icons.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.5.0",
    "@google/genai": "^2.4.0",
    "@stylexjs/stylex": "^0.19.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.5",
    "dagre": "^0.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "konva": "^9.3.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.5.0",
    "@types/dagre": "^0.7.54",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
