# Optional Render/container runtime for company-template PDF finalization.
# The ordinary native Node deployment remains supported and fails closed to the
# legacy PDF when LibreOffice is not operational.
FROM node:22-bookworm-slim

ENV DOCUMENT_PDF_CONVERTER_PATH=/usr/bin/soffice

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
    fontconfig \
    fonts-liberation \
    fonts-noto-core \
    libreoffice-writer \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY . .
RUN npm run build

ENV NODE_ENV=production
USER node
EXPOSE 3000
CMD ["npm", "start"]
